# Copy this file to .env and fill in your own values.
# .env is git-ignored and must never be committed, shared or zipped.

# Required: your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=replace_with_your_api_key

# Model used for the analysis. Any model with Structured Outputs support works; add its
# prices to config/model_pricing.json (or the OPENAI_PRICE_* variables below) for cost tracking.
OPENAI_MODEL=gpt-6-luna

# Optional: an OpenAI-compatible gateway instead of api.openai.com. For OpenRouter use an
# OpenRouter key above, set OPENAI_MODEL=openai/gpt-6-luna and uncomment:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Optional: reasoning effort for reasoning models (gpt-6 / gpt-5.x: none, low, medium, high).
# Leave empty for non-reasoning models such as gpt-4.1-mini.
OPENAI_REASONING_EFFORT=low

# Optional: request limits
OPENAI_MAX_OUTPUT_TOKENS=1500
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_ATTEMPTS=4

# Optional: scraping politeness (robots.txt Crawl-delay is always honoured on top of this)
SCRAPER_DELAY_SECONDS=1.5
SCRAPER_MAX_RETRIES=3

# Optional: price overrides in USD per 1M tokens, for a model missing from config/model_pricing.json
# OPENAI_PRICE_INPUT_PER_1M=
# OPENAI_PRICE_CACHED_INPUT_PER_1M=
# OPENAI_PRICE_CACHE_WRITE_PER_1M=
# OPENAI_PRICE_OUTPUT_PER_1M=
